# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como ".env" y rellena los valores reales.
# El .env real NUNCA debe subirse a git.
# ============================================================

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=Dental-One

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Token de acceso de Mercado Pago (PRUEBA: TEST-... · PRODUCCIÓN: APP_USR-...)
MP_ACCESS_TOKEN=APP_USR-663304607769346-050823-cc86e1d75bef2c20c10964bfa4e42f23-3387439025

# URL base del front-end para las back_urls de Mercado Pago (ej: http://localhost:4200)
FRONTEND_URL=http://localhost:4200

# URL pública del webhook de Mercado Pago (ngrok en local; tu dominio en prod)
MP_NOTIFICATION_URL=https://hq3ptck7-3000.usw3.devtunnels.ms/mercado-pago/webhook

# Correo (Gmail) para confirmaciones de cita.
# EMAIL_PASS debe ser una "Contraseña de aplicación" de Google (no la normal).
EMAIL_USER=montoya.martinez.juan.cb284@gmail.com
EMAIL_PASS=jbkg lczo ibvj qtlu

# Google Calendar (opcional): ruta al JSON de cuenta de servicio + ID del calendario
# GOOGLE_CALENDAR_KEYFILE=
# GOOGLE_CALENDAR_ID=

# WhatsApp (Twilio) para notificaciones de citas
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
# Número de WhatsApp Sandbox de Twilio (formato: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Origen permitido para CORS (en producción, tu dominio). Ej: https://dentalone.mx
# Déjalo vacío en desarrollo para permitir todos los orígenes.
CORS_ORIGIN=
