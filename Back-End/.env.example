# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como ".env" y rellena los valores reales.
# El .env real NUNCA debe subirse a git.
# En Render, captura estas mismas variables en "Environment".
# ============================================================

# --- Base de datos ------------------------------------------
# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/Dental-One?appName=Dental-One

# --- Seguridad ----------------------------------------------
# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- URLs públicas ------------------------------------------
# URL del front-end (back_urls de Mercado Pago, enlaces de correos). Sin "/" al final.
# Producción: https://<tu-sitio>.netlify.app
FRONTEND_URL=http://localhost:4200

# URL pública de este backend (enlace de verificación de correo). Sin "/" al final.
# Producción: https://<tu-servicio>.onrender.com
BACKEND_URL=http://localhost:3000

# Origen permitido para CORS (en producción, la URL de Netlify). Ej: https://<tu-sitio>.netlify.app
# Déjalo vacío en desarrollo para permitir todos los orígenes.
CORS_ORIGIN=

# Puerto del servidor (opcional, por defecto 3000; Render lo asigna solo)
PORT=3000

# --- Mercado Pago -------------------------------------------
# Token de acceso (PRUEBA: TEST-... · PRODUCCIÓN: APP_USR-...)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx

# URL pública del webhook. Si se omite y BACKEND_URL es pública, se usa
# ${BACKEND_URL}/mercado-pago/webhook. En local usa un túnel (ngrok, devtunnels).
MP_NOTIFICATION_URL=

# Clave secreta del webhook (panel de MP > Tus integraciones > Webhooks).
# Si se define, se valida la firma x-signature de cada notificación.
MP_WEBHOOK_SECRET=

# --- Correo -------------------------------------------------
# Proveedor: 'resend' (API HTTP, funciona en Render gratis) o 'smtp' (Gmail).
# Si se omite: 'resend' cuando hay RESEND_API_KEY, si no 'smtp'.
EMAIL_PROVIDER=
# API key de https://resend.com (re_...)
RESEND_API_KEY=
# Remitente. Con Resend debe ser de un dominio verificado; para pruebas usa
# "Dental One <onboarding@resend.dev>" (solo entrega a tu propio correo de Resend).
EMAIL_FROM=
# Cuenta de Gmail para SMTP. EMAIL_PASS es una "Contraseña de aplicación" de Google.
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Correo que recibe los mensajes del formulario de contacto (por defecto EMAIL_USER)
CONTACT_EMAIL=

# --- WhatsApp (Twilio, opcional) ----------------------------
# Si faltan, simplemente no se envían recordatorios por WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remitente con código de país, sin "whatsapp:". Ej: +14155238886 (sandbox)
TWILIO_PHONE_NUMBER=

# --- Google Calendar (opcional) -----------------------------
# Ruta ABSOLUTA al JSON de la cuenta de servicio y el ID del calendario.
# Si el archivo no existe, la integración se desactiva sin romper las citas.
GOOGLE_CALENDAR_KEYFILE=
GOOGLE_CALENDAR_ID=
